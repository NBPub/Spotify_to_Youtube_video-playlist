# Match strictness for phase 2 YouTube search (low/medium/high, default: medium)
#   low    — fuzzy song match only; all parentheticals stripped from song name (e.g. "(Interlude)"),
#             then all unique remaining words must appear in title (no artist check)
#   medium — song title + any artist in semicolon-separated list matches title or channel
#   high   — song title + primary artist only (official music video filtering pending)
MATCH_STRICTNESS=medium

# Spotify credentials — only required for phase1_spotify.py (user-owned playlists).
# Not needed for the primary Exportify-based workflow.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
PLAYLIST_FOLDER=your_spotify_playlists_folder_name
